# Neon PostgreSQL Connection Strings
# DATABASE_URL: Pooled connection string (-pooler.neon.tech) used by Prisma Client at runtime on Vercel
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.neon.tech/neondb?sslmode=require"

# DIRECT_URL: Direct compute connection string (non-pooled) used by Prisma CLI for migrations
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].neon.tech/neondb?sslmode=require"

# CMS Admin Authentication
# ADMIN_PASSWORD: High-entropy passphrase for the single CMS owner
ADMIN_PASSWORD="replace_with_secure_production_password"

# ADMIN_SESSION_SECRET: 32+ character cryptographic secret for signing session cookies
ADMIN_SESSION_SECRET="replace_with_32_character_random_hex_or_string"
