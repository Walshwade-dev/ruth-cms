generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                  String   @id @default("default")
  name                String
  title               String
  institution         String
  programme           String
  level               String
  statement           String
  bio                 String?
  careerDirection     String[]
  imageUrl            String?
  imageAspect         String?  @default("aspect-[3/4]")
  imageObjectPosition String?  @default("center 30%")

  contact             Contact?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  socials   Json?

  profileId String   @unique @default("default")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

model Project {
  id                  String   @id @default(cuid())
  slug                String   @unique
  title               String
  category            String   @default("")
  status              String   @default("Draft")
  summary             String?
  ctaLabel            String?
  confirmedDetails    String[]
  suggestedContext    String[]
  featuredImage       String?
  featuredImageAlt    String?
  imageAspect         String?  @default("aspect-[3/4]")
  imageObjectPosition String?  @default("center")
  order               Int      @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
